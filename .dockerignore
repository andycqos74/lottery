# Keep secrets, local config and build leftovers out of the Docker build
# context. The Dockerfile does `COPY . .`, so anything not listed here is sent
# to the builder and lands in an intermediate layer, even if the runtime image
# never copies it.

# Secrets and real configuration — never belong in any image layer.
deploy/secrets
deploy/.env
**/.env
**/*.key
**/*.pem

# Version control and local tooling
.git
.github
.claude
.vscode
.idea

# Rebuilt inside the image (pnpm install / tsc -b)
**/node_modules
**/dist
**/*.tsbuildinfo
coverage

# Real member data must never enter an image (build plan blocker B-2).
**/*.xlsx
**/*.xls
**/*.csv
!fixtures/**/*.csv

# Logs and scratch
**/*.log
tmp
