# Copy to deploy/.env and fill in. NEVER commit the filled-in copy.
#
#   cp deploy/.env.example deploy/.env
#
# Secrets do NOT live here — they are files under deploy/secrets/, generated by
# deploy/bootstrap/generate-secrets.sh. An environment variable leaks into
# `docker inspect` and into every child process; a mounted file does not.

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Hostnames (all must resolve to this VPS) ─────────────────────────────────
PUBLIC_HOST=lottery.qosfc.example
MEMBER_HOST=my.lottery.qosfc.example
ADMIN_HOST=admin.lottery.qosfc.example
TEMPORAL_UI_HOST=temporal.lottery.qosfc.example
CODEC_HOST=codec.lottery.qosfc.example

PUBLIC_BASE_URL=https://lottery.qosfc.example
ADMIN_BASE_URL=https://admin.lottery.qosfc.example
TEMPORAL_UI_URL=https://temporal.lottery.qosfc.example
CODEC_SERVER_URL=https://codec.lottery.qosfc.example

ACME_EMAIL=treasurer@qosfc.example

# ── Admin access control ──────────────────────────────────────────────────────
# Space-separated CIDRs allowed to reach the admin console, Temporal UI and codec
# server. This sits IN FRONT of authentication, so a credential-stuffing attempt
# never reaches the login form. Narrow it as far as you can bear.
ADMIN_ALLOWED_CIDRS=203.0.113.0/24

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_NAMESPACE=qosfc-lottery
TEMPORAL_RETENTION=30d
# Printed by generate-secrets.sh. Retired keys stay in deploy/secrets/codec/ so
# older history remains decryptable.
TEMPORAL_CODEC_ACTIVE_KEY_ID=key-202608

# ── Provider selection (build plan §5) ────────────────────────────────────────
# `sandbox` routes to the dummy providers. The composition root REFUSES to start
# with NODE_ENV=production and any sandbox adapter, so this cannot be forgotten
# on go-live — but set them deliberately anyway.
#
# Blocked on: GAP-09 (PSP), GAP-10 (Bacs route), GAP-33 (bank feed), GAP-30
# (notification channel). Until those are decided, `sandbox` is the only value.
PAYMENT_GATEWAY=sandbox
BACS_BUREAU=sandbox
BANK_FEED=sandbox
NOTIFIER=sandbox

# GAP-21 ⛔ — the acceptable entropy source is a LICENCE CONDITION question for
# the registering authority, not a technical preference. `unset` makes the draw
# halt and raise a task rather than generate numbers nobody has approved.
# Valid once decided: csprng | external_certified | manual_physical_draw
RANDOMNESS_SOURCE=unset

# ── Sandbox behaviour (development only) ──────────────────────────────────────
SANDBOX_DECLINE_RATE=0.1
SANDBOX_DUPLICATE_WEBHOOK_RATE=0.05
SANDBOX_BACS_SETTLEMENT_DAYS=3
SANDBOX_TIME_SCALE=1
